rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      // عرض المنتجات للجميع، والكتابة لحساب الإدارة فقط.
      allow read: if true;

      allow create, update, delete: if request.auth != null
        && request.auth.uid == "7991uL0Cz5d501Qkfn8Hu4xedSc2";
    }

    match /orders/{orderId} {
      // السماح للزوار بإنشاء الطلبات.
      allow create: if request.resource.data.keys().hasAll([
          'id',
          'items',
          'total',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'items',
          'total',
          'status',
          'createdAt'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      // قراءة وتعديل وحذف الطلبات للإدارة فقط.
      allow read, update, delete: if request.auth != null
        && request.auth.uid == "7991uL0Cz5d501Qkfn8Hu4xedSc2";
    }
  }
}